# Reference/example for backend/.env.shared, the single file
# development/dev-loop.js's ensureBackendEnv() creates and reads for values
# that must be IDENTICAL across every backend service (one Mongo cluster,
# one JWT signing secret) — see ALWAYS_CONFIRM_KEY_PATTERN in dev-loop.js.
# Per-service cosmetic values (each service's own PORT, etc.) live in that
# service's own .env.example instead, not here.
#
# JWT_SECRET is shared between user-service (issues tokens on admin login)
# and gateway (verifies tokens on every proxied request). appointment-service
# never needs it — it trusts gateway's internal x-user-id/x-user-role headers.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
FRONTEND_ORIGIN=http://localhost:5173
