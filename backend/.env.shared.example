# TEMPLATE — fill during project setup.
#   This is the reference/example for backend/.env.shared, the single file
#   development/dev-loop.js's ensureBackendEnv() creates and reads for values
#   that must be IDENTICAL across every backend service (one Mongo cluster,
#   one JWT signing secret) — see ALWAYS_CONFIRM_KEY_PATTERN in dev-loop.js.
#   Per-service cosmetic values (each service's own PORT, etc.) live in that
#   service's own .env.example instead, not here.
# Delete this comment block once filled.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=
FRONTEND_ORIGIN=
