PORT=4002
MONGODB_URI=mongodb://localhost:27017/user-service
FRONTEND_ORIGIN=http://localhost:5173
# Must be IDENTICAL to api-gateway's JWT_SECRET — user-service signs the token
# and api-gateway verifies it. Login returns 500 if this is left blank.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Used ONLY by `npm run seed:admin` (the one-time bootstrap of the single v1
# Admin account) — not read by the running server. Fill these in your local env
# file before running the seed; never commit real values here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
