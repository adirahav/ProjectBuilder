PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-me-must-match-user-service
JWT_EXPIRES_IN=1d
BOOKING_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
NOTIFICATION_SERVICE_URL=http://localhost:4003

# Single-origin deploy (DEPLOYSE-APIG).
# SERVE_FRONTEND: serve the frontend's production build from this gateway so
# the SPA and the API share one origin/port. Leave unset to auto-detect
# (enabled only if <repo>/frontend/dist/index.html exists), which keeps local
# dev with the Vite dev server unaffected. Set to true/false to force it.
# SERVE_FRONTEND=true
# FRONTEND_DIST_PATH: override the built-frontend directory. Defaults to
# <repo>/frontend/dist. Useful when the build is copied elsewhere on deploy.
# FRONTEND_DIST_PATH=/srv/app/frontend/dist
