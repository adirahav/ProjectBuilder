# Reference/example for backend/.env.shared, the single file
# development/dev-loop.js's ensureBackendEnv() creates and reads for values
# that must be IDENTICAL across every backend service that needs them.
# MONGODB_URI is used by booking-service and user-service (notification-service
# has no persistent domain model in v1). JWT_SECRET/JWT_EXPIRES_IN are used by
# api-gateway (verifies) and user-service (issues) only. FRONTEND_ORIGIN is used
# by api-gateway for CORS. Per-service cosmetic values (each service's own
# PORT, etc.) live in that service's own .env.example instead, not here.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=
FRONTEND_ORIGIN=
