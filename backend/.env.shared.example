# backend/.env.shared — values IDENTICAL across every ClinicBook backend
# service (appointment-service, catalog-service, user-management-service,
# api-gateway). scripts/dev-loop.js's ensureBackendEnv() creates and reads
# this file — see ALWAYS_CONFIRM_KEY_PATTERN in dev-loop.js.
# Per-service cosmetic values (each service's own PORT, etc.) live in that
# service's own .env.example instead, not here.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173
