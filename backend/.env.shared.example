# Hila Tours — reference/example for backend/.env.shared, the single file
# development/dev-loop.js's ensureBackendEnv() creates and reads for values
# that must be IDENTICAL across every backend service (tour-service,
# user-management-service): one Mongo cluster, one JWT signing secret — see
# ALWAYS_CONFIRM_KEY_PATTERN in dev-loop.js.
# Per-service cosmetic values (each service's own PORT, etc.) live in that
# service's own .env.example instead, not here.
MONGODB_URI=mongodb://localhost:27017/hila-tours
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173
