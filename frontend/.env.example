# Base URL of booking-service. The public booking routes (GET /api/services,
# /api/time-slots, ...) are unauthenticated and are called directly, so the
# frontend talks to booking-service rather than api-gateway for them.
VITE_BOOKING_SERVICE_URL=http://localhost:4001

# Base URL of api-gateway. Every Admin route goes through the gateway, because
# that is where the JWT is verified (PRD F5-F11, AC-7). Admin Login is the one
# unauthenticated route on it — it is how the token is obtained in the first
# place.
VITE_API_GATEWAY_URL=http://localhost:4000
