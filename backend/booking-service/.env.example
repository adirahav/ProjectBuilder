PORT=4001
MONGODB_URI=mongodb://localhost:27017/booking-service
FRONTEND_ORIGIN=http://localhost:5173
# Server-to-server only (PRD F4b). booking-service fires a best-effort
# confirmation notification here after an Appointment is created; it is never
# called from a browser, and its unavailability never fails a booking.
NOTIFICATION_SERVICE_URL=http://localhost:4003
