# tour-service — placeholders only. Copy to the local per-environment file
# (`.env.<NODE_ENV>`, which config.ts loads by explicit path) and fill in real
# values there. Never commit a file containing real credentials.

PORT=4001
MONGODB_URI=mongodb://localhost:27017/hila-tours

# MUST be byte-identical to user-management-service's JWT_SECRET: that service
# issues tokens, this one verifies them independently with no runtime lookup
# between the two. No endpoint in the current API contract uses it — the whole
# passenger flow is public — but the admin routes landing later will.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CORS allows this origin only.
FRONTEND_ORIGIN=http://localhost:5173
