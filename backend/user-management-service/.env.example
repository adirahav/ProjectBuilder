# user-management-service — placeholders only. Copy to the local per-environment
# file (`.env.<NODE_ENV>`, which config.ts loads by explicit path) and fill in
# real values there. Never commit a file containing real credentials.

PORT=4002
MONGODB_URI=mongodb://localhost:27017/hila-tours
# Optional: selects the database when MONGODB_URI has no path segment (the
# shared cluster URI in backend/.env.shared does not).
DB_NAME=

# MUST be byte-identical to tour-service's JWT_SECRET: THIS service issues the
# tokens, tour-service verifies them independently with no runtime lookup
# between the two. Keep the shared value in backend/.env.shared.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CORS allows this origin only.
FRONTEND_ORIGIN=http://localhost:5173
